---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Optional bot protection: create a Turnstile widget in the Cloudflare
// dashboard (free), paste its site key here, and set the matching secret
// as the TURNSTILE_SECRET env var on the Pages project. While this is
// empty, the widget is not rendered and /api/contact skips the check.
const TURNSTILE_SITE_KEY = '';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Contact | Alternating.ai</title>
    <meta name="description" content="Get in touch with Alternating.ai. Send us a message and we'll get back to you." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:raw>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'dark';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="antialiased">
    <Header title="Contact" description="Get in touch with Alternating.ai" />

    <main class="pt-16 min-h-screen flex flex-col">
      <section class="relative flex-1 overflow-hidden">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 w-full">
          <div class="text-center mb-10 animate-fade-in">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-700/40 mb-6">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-violet-600 dark:text-violet-300">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span class="text-xs font-semibold text-violet-700 dark:text-violet-300 tracking-wide uppercase">Contact</span>
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tighter text-gray-900 dark:text-white mb-4">Get in touch</h1>
            <p class="text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto leading-relaxed">
              Questions, feedback, or want a free AI blueprint? Send us a note and we'll get back to you.
            </p>
          </div>

          <form id="contact-form" class="feature-card p-6 sm:p-8 text-left animate-fade-in delay-100" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label for="contact-name" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Name</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  placeholder="Your name"
                  class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-violet-500/40 transition"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Email</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  placeholder="you@email.com"
                  class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-violet-500/40 transition"
                />
              </div>
            </div>
            <div class="mb-4">
              <label for="contact-message" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Message</label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="5"
                placeholder="How can we help?"
                class="w-full px-4 py-3 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-violet-500/40 transition resize-y"
              ></textarea>
            </div>
            <!-- Honeypot: hidden from humans; if a bot fills it in, the
                 server pretends success and sends nothing. -->
            <div class="hidden" aria-hidden="true">
              <label for="contact-company">Company</label>
              <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>
            {TURNSTILE_SITE_KEY && (
              <div class="mb-4">
                <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
              </div>
            )}
            <button type="submit" id="contact-send" class="btn-primary w-full justify-center text-base">
              Send message
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </button>
            <p id="contact-msg" class="mt-4 text-sm font-medium text-emerald-600 dark:text-emerald-400 hidden text-center"></p>

          </form>
        </div>
      </section>

      <Footer />
    </main>

    {TURNSTILE_SITE_KEY && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async></script>
    )}
    <script>
      import { sendMessage } from '../lib/contactForm.js';

      const form = document.getElementById('contact-form');
      const msg = document.getElementById('contact-msg');
      const sendBtn = form?.querySelector('#contact-send');

      function setMsg(text, warn) {
        if (!msg) return;
        msg.classList.remove('hidden');
        msg.textContent = text;
        msg.className = 'mt-4 text-sm font-medium text-center ' +
          (warn ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600 dark:text-emerald-400');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = form.querySelector('#contact-name')?.value?.trim() || '';
        const email = form.querySelector('#contact-email')?.value?.trim() || '';
        const message = form.querySelector('#contact-message')?.value?.trim() || '';
        const company = form.querySelector('#contact-company')?.value || '';
        let token = '';
        try { token = window.turnstile ? window.turnstile.getResponse() : ''; } catch (_) {}

        if (sendBtn) sendBtn.disabled = true;
        try {
          const result = await sendMessage({ name, email, message, topic: 'Contact form', company, token });
          if (result.ok) {
            setMsg('Thanks! Your message is on its way. We\'ll get back to you soon. 🚀', false);
            form.reset();
            try { window.turnstile && window.turnstile.reset(); } catch (_) {}
          } else if (result.fallbackUrl) {
            window.location.href = result.fallbackUrl;
            setMsg('Your email app has opened. Please hit send to deliver. 🚀', false);
          } else {
            setMsg(result.error || 'Something went wrong. Please try again.', true);
          }
        } finally {
          if (sendBtn) sendBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>