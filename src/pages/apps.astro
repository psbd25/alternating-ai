---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpellingBee from '../components/SpellingBee.astro';
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Apps | Alternating.ai</title>
    <meta name="description" content="Educational apps and tools from Alternating.ai" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:raw>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="antialiased">
    <Header title="Apps" description="Educational apps and tools" />

    <main class="pt-16 min-h-screen flex flex-col">
      <section class="text-center py-12 px-4">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Educational Apps</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Interactive learning tools designed to make education fun and effective
        </p>
      </section>

      <section class="flex-1 container mx-auto px-4 py-8">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <SpellingBee />

          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="bg-gray-100 dark:bg-gray-700/40 px-6 py-4 border-b border-gray-200 dark:border-gray-700">
              <h2 class="text-xl font-bold text-teal-600 dark:text-teal-300">Coming Soon</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">More educational apps</p>
            </div>
            <div class="p-6 text-center py-8">
              <div class="w-16 h-16 mx-auto bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center text-teal-600 dark:text-teal-300 text-2xl mb-3">?</div>
              <p class="text-gray-500 dark:text-gray-400">New apps in development</p>
            </div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="bg-gray-100 dark:bg-gray-700/40 px-6 py-4 border-b border-gray-200 dark:border-gray-700">
              <h2 class="text-xl font-bold text-amber-600 dark:text-amber-300">Coming Soon</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">More educational apps</p>
            </div>
            <div class="p-6 text-center py-8">
              <div class="w-16 h-16 mx-auto bg-gray-200 dark:bg-gray-700 rounded-xl flex items-center justify-center text-amber-600 dark:text-amber-300 text-2xl mb-3">?</div>
              <p class="text-gray-500 dark:text-gray-400">New apps in development</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

  </body>
</html>

