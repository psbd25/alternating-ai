---
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const allPosts = await getCollection('blog');
const sortedPosts = [...allPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Compute tag counts
const tagCounts = {};
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const tagList = Object.entries(tagCounts)
  .sort((a, b) => (b[1] !== a[1] ? b[1] - a[1] : a[0].localeCompare(b[0])))
  .map(([tag, count]) => ({ tag, count }));

// Optional ?tag= filter
const activeTag = Astro.url.searchParams.get('tag');
const posts = activeTag ? allPosts.filter((p) => (p.data.tags || []).includes(activeTag)) : allPosts;

function cleanDesc(post) {
  const raw = post.data.summary || post.body;
  return raw.replace(/[#>*`-]/g, ' ').replace(/\s+/g, ' ').trim();
}

const totalPosts = allPosts.length;
const totalTopics = tagList.length;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Blog — Notes on AI | Alternating.ai</title>
    <meta
      name="description"
      content="Clear, human-written notes on AI — what it is, what it means, and where it's headed. Written for builders, students, and the curious."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:raw>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'dark';
        if (theme === 'dark') document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>
  </head>
  <body class="antialiased">
    <Header title="Blog" description="Human-written notes on AI" />

    <main class="pt-16">
      <!-- ===== Blog Hero ===== -->
      <section class="relative overflow-hidden">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 lg:pt-28 pb-12 sm:pb-16 text-center">
          <div class="animate-fade-in">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-700/40 mb-8">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-semibold text-violet-700 dark:text-violet-300 tracking-wide uppercase">The Blog</span>
            </div>
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter text-gray-900 dark:text-white mb-6 animate-fade-in delay-100">
            A human's take on
            <span class="block bg-gradient-to-r from-violet-600 via-indigo-500 to-fuchsia-500 dark:from-violet-400 dark:via-indigo-400 dark:to-fuchsia-400 bg-clip-text text-transparent">
              AI
            </span>
          </h1>
          <p class="text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in delay-200">
            Clear, human-written notes on AI — what it is, what it means, and where it's headed. No AI summaries, no filler.
          </p>

          <!-- Real stats -->
          <div class="max-w-2xl mx-auto animate-fade-in delay-300">
            <div class="grid grid-cols-3 gap-4 p-5 rounded-2xl bg-white/80 dark:bg-white/5 backdrop-blur-xl border border-gray-200/80 dark:border-white/10">
              <div class="text-center">
                <div class="stat-value text-2xl sm:text-3xl">{totalPosts}</div>
                <div class="stat-label text-xs">Articles</div>
              </div>
              <div class="text-center">
                <div class="stat-value text-2xl sm:text-3xl">{totalTopics}</div>
                <div class="stat-label text-xs">Topics</div>
              </div>
              <div class="text-center">
                <div class="stat-value text-2xl sm:text-3xl">0</div>
                <div class="stat-label text-xs">AI-written</div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="section-divider max-w-4xl mx-auto"></div>

      <!-- ===== Search + Keyword Index ===== -->
      <section class="py-10 sm:py-14">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="feature-card p-6 sm:p-8">
            <div class="mb-6">
              <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Search the blog</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">Find a specific article or browse by keyword below.</p>
            </div>

            <!-- Search input -->
            <div class="relative mb-6">
              <svg
                class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500 pointer-events-none"
                width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              <input
                id="search-input"
                type="search"
                placeholder="Search articles… (e.g. ethics, business, machine learning)"
                aria-label="Search articles"
                class="w-full pl-11 pr-4 py-3 rounded-full bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-violet-500/40 focus:border-violet-400 dark:focus:border-violet-500/50 transition"
              />
            </div>

            <!-- Keyword index -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500">Browse by keyword</span>
                {activeTag && (
                  <a href="/blog" class="text-xs font-semibold text-violet-600 dark:text-violet-400 hover:underline">Clear filter ✕</a>
                )}
              </div>
              <div class="flex flex-wrap gap-2">
                {tagList.map(({ tag, count }) => {
                  const active = tag === activeTag;
                  return (
                    <a
                      href={`/blog?tag=${encodeURIComponent(tag)}`}
                      class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all ${
                        active
                          ? 'bg-violet-600 text-white shadow-md shadow-violet-500/25'
                          : 'bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 hover:bg-violet-100 dark:hover:bg-violet-900/30 hover:text-violet-700 dark:hover:text-violet-300'
                      }`}
                    >
                      {tag}
                      <span class={`text-xs ${active ? 'text-violet-200' : 'text-gray-400 dark:text-gray-500'}`}>{count}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- ===== Post Grid ===== -->
      <section class="pb-16 sm:pb-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
              {activeTag ? `Tagged “${activeTag}”` : 'Latest Articles'}
            </h2>
            <span class="text-sm text-gray-400 dark:text-gray-500" id="result-count">
              {posts.length} {posts.length === 1 ? 'article' : 'articles'}
            </span>
          </div>

          <div id="post-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
            {posts.map((post) => (
              <article
                class="post-card feature-card group cursor-pointer flex flex-col"
                data-title={post.data.title.toLowerCase()}
                data-tags={(post.data.tags || []).join(' ').toLowerCase()}
                data-summary={cleanDesc(post).toLowerCase()}
              >
                <span class="text-xs text-gray-400 dark:text-gray-500 font-medium mb-3 content-blur">
                  {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors leading-snug content-blur">
                  {post.data.title}
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4 flex-1 content-blur">
                  {cleanDesc(post).slice(0, 140)}
                  {cleanDesc(post).length > 140 ? '…' : ''}
                </p>
                <div class="flex items-center justify-between mt-auto">
                  <div class="flex flex-wrap gap-1.5">
                    {(post.data.tags || []).slice(0, 2).map((tag) => (
                      <span class="tag-pill tag-purple">{tag}</span>
                    ))}
                  </div>
                  <a
                    href={`/blog/${post.id.replace(/\.md$/, '')}`}
                    class="text-xs font-semibold text-violet-500 dark:text-violet-400 flex items-center gap-1 group-hover:gap-2 transition-all"
                  >
                    Read
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <!-- Empty state (shown when search matches nothing) -->
          <div id="no-results" class="hidden text-center py-16">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">No articles found</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Try a different keyword, or clear your search.</p>
            <button id="clear-search" class="btn-secondary text-sm px-5 py-2.5">Clear search</button>
          </div>
        </div>
      </section>

      <!-- ===== Newsletter ===== -->
      <section class="py-8 sm:py-12">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <Newsletter />
        </div>
      </section>

      <!-- ===== Footer ===== -->
      <Footer />
    </main>

    <script>
      const input = document.getElementById('search-input');
      const cards = Array.from(document.querySelectorAll('.post-card'));
      const noResults = document.getElementById('no-results');
      const grid = document.getElementById('post-grid');
      const clearBtn = document.getElementById('clear-search');

      function applySearch() {
        const q = (input?.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const haystack = `${card.dataset.title || ''} ${card.dataset.tags || ''} ${card.dataset.summary || ''}`;
          const match = q === '' || haystack.includes(q);
          card.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        if (noResults) noResults.classList.toggle('hidden', visible !== 0);
        if (grid) grid.classList.toggle('hidden', visible === 0);
      }

      input?.addEventListener('input', applySearch);
      clearBtn?.addEventListener('click', () => {
        if (input) input.value = '';
        applySearch();
        input?.focus();
      });
    </script>
  </body>
</html>
