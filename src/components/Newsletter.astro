---
---
<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-600 via-indigo-600 to-fuchsia-600 p-8 sm:p-12 lg:p-16 shadow-2xl shadow-violet-500/25">
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-pink-400/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative text-center max-w-2xl mx-auto">
    <!-- Icon -->
    <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-6">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight">
      Stay Ahead of the Curve
    </h2>
    <p class="text-purple-100/90 text-base sm:text-lg mb-8 leading-relaxed">
      Get the latest AI strategies, case studies, and implementation guides delivered to your inbox. No spam, unsubscribe anytime.
    </p>

    <!-- Form -->
    <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input
        type="email"
        name="email"
        placeholder="Enter your email"
        required
        class="flex-1 px-5 py-3.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/20 text-white placeholder-purple-200/70 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white/20 transition-all text-sm"
      />
      <button
        type="submit"
        class="px-7 py-3.5 bg-white text-indigo-600 font-bold rounded-full hover:bg-indigo-50 hover:shadow-lg transition-all duration-200 whitespace-nowrap text-sm"
      >
        Subscribe
      </button>
    </form>

    <p class="text-purple-200/60 text-xs mt-5">Free updates on new posts &amp; the launch. No spam — unsubscribe anytime.</p>
  </div>

  <script>
    document.querySelector('#newsletter-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const form = e.target;
      const email = form.querySelector('input[name="email"]')?.value || '';
      const subject = encodeURIComponent('Newsletter signup — Alternating.ai');
      const body = encodeURIComponent(
        `Hi, I'd like to subscribe to the Alternating.ai newsletter and be notified about the launch.\n\nMy email: ${email}`
      );
      window.location.href = `mailto:psbd225@gmail.com?subject=${subject}&body=${body}`;
      form.innerHTML = '<p style="color:#ffffff;font-weight:600;font-size:0.875rem;">Thanks for subscribing! We’ll be in touch soon. ✉️</p>';
    });
  </script>
</section>