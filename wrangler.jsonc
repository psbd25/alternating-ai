{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "alternating-ai",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"send_email": [
		{ "name": "EMAIL" }
	],
	"observability": {
		"enabled": true
	}
}